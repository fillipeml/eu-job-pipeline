# Copy to .env. Every variable is optional; the defaults run the demo.

# true = offline: sources read fixtures/, scoring is the deterministic heuristic, store is .demo/jobs.sqlite
DEMO_MODE=true

# Where the SQLite store lives (default: .demo/jobs.sqlite in demo mode, data/jobs.sqlite otherwise)
# DB_PATH=data/jobs.sqlite

# Candidate profile read by both scorers (falls back to profile.example.md)
# PROFILE_PATH=profile.md

# --- Live mode: LLM scoring -------------------------------------------------------------
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5        # cheaper for bulk runs: claude-sonnet-5, claude-haiku-4-5
# ANTHROPIC_EFFORT=medium              # low | medium | high | xhigh | max
# LLM_MAX_TOKENS=1024

# --- Sources ----------------------------------------------------------------------------
# Comma-separated search terms (Arbeitnow, Greenhouse and Lever are filtered client-side;
# Bundesagentur searches server-side)
# QUERIES=AI engineer,Data engineer,LLM engineer,Machine learning engineer
# TARGET_COUNTRIES=DE,NL,IE,PT,SE,DK,FI,NO,AT,CH,BE,ES,FR,EU
# ARBEITNOW_PAGES=3
# BUNDESAGENTUR_PAGE_SIZE=100
# Greenhouse board tokens and Lever company slugs of employers you follow
# GREENHOUSE_BOARDS=
# LEVER_COMPANIES=
# HTTP_TIMEOUT_SECONDS=20
